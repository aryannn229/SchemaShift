# Copy to .env (never commit .env)
POSTGRES_USER=schemashift
POSTGRES_PASSWORD=change-me
POSTGRES_DB=schemashift_app
APP_DATABASE_URL=postgresql+psycopg://schemashift:change-me@localhost:5432/schemashift_app
# Verification sandboxes: a role allowed to CREATE ROLE / CREATE SCHEMA in the sandbox database
SANDBOX_ADMIN_DATABASE_URL=postgresql://sandbox_admin:change-me@localhost:5432/schemashift_sandbox
# Optional MongoDB user limited to readWrite on run_* databases (falls back to MONGO_URL)
MONGO_SANDBOX_URL=
MONGO_URL=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
CORS_ORIGINS=http://localhost:5173
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
SENTRY_DSN=
VITE_API_URL=http://localhost:8000

# Host ports (change if they clash with other local projects)
POSTGRES_PORT=5432
MONGO_PORT=27017
BACKEND_PORT=8000
FRONTEND_PORT=5173
